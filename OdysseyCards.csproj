<Project Sdk="Godot.NET.Sdk/4.7.0">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <!-- 版本号唯一真源：仓库根目录 VERSION 文件（单行，无 v 前缀）。
             运行时通过 VersionInfo.cs 反射读取 AssemblyInformationalVersion。 -->
        <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
        <InformationalVersion>$(Version)</InformationalVersion>

        <!-- 禁止 SDK 自动生成 AssemblyInfo.cs —— Godot.NET.Sdk 在多配置
             (Debug/ExportDebug/ExportRelease) 下会重复生成 Company/Product/Version
             等特性到同一 obj 路径导致 CS0579。所需特性改由下方 AssemblyAttribute
             ItemGroup 显式注入，避免重复。 -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

        <!-- 代码分析增强 -->
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <!-- 抑制不适用于 Godot 项目的分析器规则：
             CA2000/CA2213: Godot 节点生命周期由引擎管理，非 .NET IDisposable
             CA1003: 项目用 event Action<> 替代 Godot [Signal]，是有意设计
             CA1305: 游戏项目不需要 IFormatProvider
             CA5394: 游戏逻辑不需要密码学安全随机
             CA1002: 返回 List<T> 是有意设计（性能 + 便利） -->
        <NoWarn>CA2000;CA2213;CA1003;CA1305;CA5394;CA1002</NoWarn>
    </PropertyGroup>

    <!-- 显式注入 VersionInfo.cs 依赖的 AssemblyInformationalVersionAttribute。
         GenerateAssemblyInfo=false 后 SDK 不再自动写此特性，需手动注入。
         其他特性（Company/Product/Title 等）不影响运行时，从略。 -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
            <_Parameter1>$(InformationalVersion)</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- 排除测试目录 (由 OdysseyCards.Tests.csproj 独立编译) -->
    <ItemGroup>
        <Compile Remove="tests\**\*.cs" />
        <None Include="tests\**\*.cs" />
    </ItemGroup>

    <!-- Roslynator 分析器 -->
    <ItemGroup>
        <PackageReference Include="Roslynator.Analyzers" Version="4.12.0" PrivateAssets="all" />
    </ItemGroup>
</Project>
