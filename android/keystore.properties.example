# OdysseyCards Android Keystore 配置模板
# 复制本文件为 keystore.properties 并填入真实值。
# keystore.properties 已 gitignore，不会提交。
#
# 生成 keystore 命令：
#   Debug:   keytool -genkeypair -v -keystore android/debug.keystore -alias androiddebugkey \
#            -storepass android -keypass android -keyalg RSA -keysize 2048 -validity 10000 \
#            -dname "CN=Android Debug, O=Android, C=US"
#   Release: keytool -genkeypair -v -keystore android/release.keystore -alias release \
#            -storepass <强密码> -keypass <强密码> -keyalg RSA -keysize 2048 -validity 9125 \
#            -dname "CN=Odyssey Cards, O=WhiteGiverMa, C=CN"
#
# 路径相对于项目根目录。build_android.ps1 会把这些值注入 Godot 环境变量。

debug.path=android/debug.keystore
debug.alias=androiddebugkey
debug.password=android

release.path=android/release.keystore
release.alias=release
release.password=请替换为你的强密码
