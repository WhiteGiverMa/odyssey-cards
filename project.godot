; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[android]

package/unique_name="com.odyssey.cards"
package/name="星途卡牌"
package/signed=true
screen/support_small=true
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
xr_features/xr_mode=0

[application]

config/name="OdysseyCards"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"
config/use_native_file_dialog=true

[autoload]

GameManager="*res://Scripts/Core/GameManager.cs"
UIScaler="*res://Scripts/UI/UIScaler.cs"
DevConsole="*res://Scripts/Infrastructure/DevConsole.cs"
MobileInputHelper="*res://Scripts/Infrastructure/MobileInputHelper.cs"
MobileInputRouter="*res://Scripts/Infrastructure/MobileInputRouter.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[dotnet]

project/assembly_name="OdysseyCards"
export/android/enable=true

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/gut/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
