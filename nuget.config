<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 包源配置
     本地源：Godot 4.7.2 Mono 安装包自带的 nupkgs，提供 Godot.NET.Sdk /
     GodotSharp / GodotSharpEditor / Godot.SourceGenerators 4.7.2，实现离线秒级还原。
     官方源：其余依赖（xUnit / Roslynator 等）。
     新增/升级 Godot 版本时同步更新此处的本地路径。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="GodotLocal" value="G:\dev\Godot_v4.7.2\GodotSharp\Tools\nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
