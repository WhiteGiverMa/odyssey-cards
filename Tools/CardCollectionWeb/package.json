{
  "name": "odyssey-card-collection-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "test": "tsx --test server/parser.test.ts src/lib/tactics.test.ts src/lib/deck.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && node scripts/verify-production.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
